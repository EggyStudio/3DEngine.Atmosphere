<Project Sdk="Microsoft.NET.Sdk">

    <!-- The library both engines reference from their own projects, which knows no engine (N 2.1). -->
    <!-- The assembly and the package carry the name of the module's family, its namespace the
         module's own. -->
    <PropertyGroup>
        <AssemblyName>3DEngine.Sky</AssemblyName>
        <PackageId>3DEngine.Sky</PackageId>
        <RootNamespace>Sky</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Every public member has a summary (STYLE.md), so a missing one stops the build, as a cref that
         names nothing does. -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    </PropertyGroup>

    <!-- The bright stars Stars reads, carried in the library so it needs no file of the engine's. -->
    <ItemGroup>
        <EmbeddedResource Include="Data/BrightStars.csv" LogicalName="Sky.BrightStars.csv" />
    </ItemGroup>

</Project>
